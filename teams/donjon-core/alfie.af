    {
      "id": "tool-12",
      "tool_type": "custom",
      "description": "Create a new Notion page under a given parent page.",
      "source_type": "json",
      "name": "create_notion_page",
      "tags": [],
      "source_code": "def create_notion_page(parent_id: str, title: str, content: str) -> str:\n    \"\"\"Create a new Notion page under a given parent page.\n\n    Args:\n        parent_id: The Notion parent page UUID under which to create the new page.\n        title: The title of the new page.\n        content: Body text for the page (paragraphs separated by double newlines).\n\n    Returns:\n        The new page URL on success, or 'ERROR: ...' on failure.\n    \"\"\"\n    import os\n    import requests\n\n    api_key = os.environ.get(\"NOTION_API_KEY\", \"\")\n    if not api_key:\n        return \"ERROR: NOTION_API_KEY not configured\"\n\n    paragraphs = [p.strip() for p in content.split(\"\\n\\n\") if p.strip()]\n    children = []\n    for para in paragraphs:\n        for i in range(0, len(para), 2000):\n            chunk = para[i:i+2000]\n            children.append({\n                \"object\": \"block\",\n                \"type\": \"paragraph\",\n                \"paragraph\": {\n                    \"rich_text\": [{\"type\": \"text\", \"text\": {\"content\": chunk}}]\n                },\n            })\n\n    payload = {\n        \"parent\": {\"page_id\": parent_id},\n        \"properties\": {\n            \"title\": {\n                \"title\": [{\"type\": \"text\", \"text\": {\"content\": title}}]\n            }\n        },\n        \"children\": children,\n    }\n    try:\n        resp = requests.post(\n            \"https://api.notion.com/v1/pages\",\n            json=payload,\n            headers={\n                \"Authorization\": f\"Bearer {api_key}\",\n                \"Notion-Version\": \"2022-06-28\",\n                \"Content-Type\": \"application/json\",\n            },\n            timeout=30,\n        )\n        if not resp.ok:\n            return f\"ERROR: HTTP {resp.status_code} \u2014 {resp.text[:300]}\"\n        page = resp.json()\n        url = page.get(\"url\", \"\")\n        page_id_result = page.get(\"id\", \"\")\n        return url or f\"OK: page_id={page_id_result}\"\n    except Exception as e:\n        return f\"ERROR: {e}\"\n",
      "json_schema": {
        "name": "create_notion_page",
        "description": "Create a new Notion page under a given parent page.",
        "parameters": {
          "type": "object",
          "properties": {
            "parent_id": {
              "type": "string",
              "description": "The Notion parent page UUID under which to create the new page."
            },
            "title": {
              "type": "string",
              "description": "The title of the new page."
            },
            "content": {
              "type": "string",
              "description": "Body text for the page (paragraphs separated by double newlines)."
            }
          },
          "required": [
            "parent_id",
            "title",
            "content"
          ]
        }
      },
      "args_json_schema": {},
      "return_char_limit": 50000,
      "pip_requirements": null,
      "npm_requirements": null,
      "default_requires_approval": null,
      "enable_parallel_execution": false,
