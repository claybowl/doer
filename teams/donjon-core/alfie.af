    {
      "id": "tool-5",
      "tool_type": "custom",
      "description": "Read any Letta memory block by its ID and return the raw value string.",
      "source_type": "json",
      "name": "read_block",
      "tags": [],
      "source_code": "def read_block(block_id: str) -> str:\n    \"\"\"Read any Letta memory block by its ID and return the raw value string.\n\n    Args:\n        block_id: The Letta block ID to read (e.g. 'block-abc123...').\n\n    Returns:\n        The raw value string of the block, or 'ERROR: ...' on failure.\n    \"\"\"\n    import os\n    import requests\n\n    base_url = os.environ.get(\"LETTA_BASE_URL\", \"https://api.letta.com/v1\").rstrip(\"/\")\n    api_key = os.environ.get(\"LETTA_API_KEY\", \"\")\n    if not block_id:\n        return \"ERROR: block_id is required\"\n    try:\n        resp = requests.get(\n            f\"{base_url}/blocks/{block_id}\",\n            headers={\"Authorization\": f\"Bearer {api_key}\"},\n            timeout=30,\n        )\n        if not resp.ok:\n            return f\"ERROR: HTTP {resp.status_code} \u2014 {resp.text[:200]}\"\n        value = resp.json().get(\"value\", \"\")\n        return value if isinstance(value, str) else str(value)\n    except Exception as e:\n        return f\"ERROR: {e}\"\n",
      "json_schema": {
        "name": "read_block",
        "description": "Read any Letta memory block by its ID and return the raw value string.",
        "parameters": {
          "type": "object",
          "properties": {
            "block_id": {
              "type": "string",
              "description": "The Letta block ID to read (e.g. 'block-abc123...')."
            }
          },
          "required": [
            "block_id"
          ]
        }
      },
      "args_json_schema": {},
      "return_char_limit": 50000,
      "pip_requirements": null,
      "npm_requirements": null,
      "default_requires_approval": null,
      "enable_parallel_execution": false,
      "created_by_id": "user-f57d9b1c-6c7e-411f-8501-a553817ffb23",
      "last_updated_by_id": "user-f57d9b1c-6c7e-411f-8501-a553817ffb23",
      "metadata_": {
        "tool_hash": "88f78cfa1fa3"
