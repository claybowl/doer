    {
      "id": "tool-10",
      "tool_type": "custom",
      "description": "Run the code in a restricted globals environment.",
      "source_type": "json",
      "name": "execute",
      "tags": [],
      "source_code": "def run_code_snippet(code: str) -> str:\n    \"\"\"Execute a Python code snippet in a restricted sandbox and return stdout.\n\n    Args:\n        code: Python source code to execute. Limited to safe builtins, 10s timeout.\n\n    Returns:\n        Stdout output (up to 2000 chars), or 'ERROR: ...' on failure or timeout.\n    \"\"\"\n    import io\n    import sys\n    import threading\n\n    result_container = {\"output\": \"\", \"error\": \"\"}\n\n    def execute():\n        \"\"\"Run the code in a restricted globals environment.\"\"\"\n        old_stdout = sys.stdout\n        sys.stdout = io.StringIO()\n        try:\n            restricted_globals = {\n                \"__builtins__\": {\n                    \"print\": print, \"len\": len, \"range\": range,\n                    \"enumerate\": enumerate, \"zip\": zip, \"map\": map,\n                    \"filter\": filter, \"sorted\": sorted, \"sum\": sum,\n                    \"min\": min, \"max\": max, \"abs\": abs, \"round\": round,\n                    \"int\": int, \"float\": float, \"str\": str, \"bool\": bool,\n                    \"list\": list, \"dict\": dict, \"set\": set, \"tuple\": tuple,\n                    \"isinstance\": isinstance, \"type\": type, \"repr\": repr,\n                    \"True\": True, \"False\": False, \"None\": None,\n                }\n            }\n            exec(code, restricted_globals, {})\n            result_container[\"output\"] = sys.stdout.getvalue()\n        except Exception as e:\n            result_container[\"error\"] = str(e)\n        finally:\n            sys.stdout = old_stdout\n\n    thread = threading.Thread(target=execute)\n    thread.start()\n    thread.join(timeout=10)\n    if thread.is_alive():\n        return \"ERROR: Execution timed out (10s limit)\"\n    if result_container[\"error\"]:\n        return f\"ERROR: {result_container['error']}\"\n    output = result_container[\"output\"]\n    return output[:2000] if output else \"(no output)\"\n",
      "json_schema": {
        "name": "execute",
        "description": "Run the code in a restricted globals environment.",
        "parameters": {
          "type": "object",
          "properties": {},
          "required": []
        }
      },
      "args_json_schema": {},
      "return_char_limit": 50000,
      "pip_requirements": null,
      "npm_requirements": null,
      "default_requires_approval": null,
      "enable_parallel_execution": false,
      "created_by_id": "user-f57d9b1c-6c7e-411f-8501-a553817ffb23",
      "last_updated_by_id": "user-f57d9b1c-6c7e-411f-8501-a553817ffb23",
