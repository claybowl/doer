      "project_id": "project-gOtlbcCC1jK8mlkoijqc"
    },
    {
      "id": "tool-4",
      "tool_type": "custom",
      "description": "Read current issues from the Paperclip kitchen queue.\n\nCall this before stocking the queue to check what's already there \u2014\nprevents duplicate issues.",
      "source_type": "python",
      "name": "read_paperclip_issues",
      "tags": [],
      "source_code": "def read_paperclip_issues(status: str = \"todo\", limit: int = 200) -> str:\n    \"\"\"Read issues from Paperclip across all projects.\n\n    Args:\n        status: \"backlog\" | \"todo\" | \"in_progress\" | \"in_review\" | \"blocked\" | \"done\" | \"cancelled\"\n        limit: Max issues to return (default 200)\n\n    Returns:\n        JSON string with list of issues, or \"ERROR: ...\" on failure.\n    \"\"\"\n    import os, json, requests\n    base_url = os.environ.get(\"PAPERCLIP_BASE_URL\", \"https://hopeful-sawfish-gently.ngrok-free.app\")\n    api_key = os.environ.get(\"PAPERCLIP_API_KEY\", \"pcp_357952ccfe77a8e42d3630f90ec4a7fb79e2f1b812a590b4\")\n    company_id = os.environ.get(\"PAPERCLIP_COMPANY_ID\", \"27b25893-0ff4-4d81-b45b-9631e04b769a\")\n    params = {\"status\": status, \"limit\": limit}\n    try:\n        resp = requests.get(\n            f\"{base_url}/api/companies/{company_id}/issues\",\n            params=params,\n            headers={\"Authorization\": f\"Bearer {api_key}\",\n                      \"ngrok-skip-browser-warning\": \"true\"},\n            timeout=30,\n        )\n        if resp.ok:\n            raw = resp.json()\n            issues = raw if isinstance(raw, list) else raw.get(\"issues\", raw.get(\"data\", []))\n            return json.dumps([{\n                \"id\": i.get(\"id\"),\n                \"identifier\": i.get(\"identifier\"),\n                \"title\": i.get(\"title\"),\n                \"status\": i.get(\"status\"),\n                \"priority\": i.get(\"priority\"),\n                \"description\": (i.get(\"description\") or \"\")[:500],\n                \"assignee\": i.get(\"assigneeAgentId\"),\n                \"projectId\": i.get(\"projectId\"),\n                \"created_at\": i.get(\"createdAt\"),\n            } for i in issues])\n        return f\"ERROR: HTTP {resp.status_code} -- {resp.text[:300]}\"\n    except Exception as e:\n        return f\"ERROR: {e}\"\n",
      "json_schema": {
        "name": "read_paperclip_issues",
        "description": "Read current issues from the Paperclip kitchen queue.\n\nCall this before stocking the queue to check what's already there \u2014\nprevents duplicate issues.",
        "parameters": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "description": "Filter by status \u2014 \"backlog\", \"todo\", \"in_progress\", \"in_review\", \"done\""
            },
            "limit": {
              "type": "integer",
              "description": "Max issues to return (default 20)"
            }
          },
          "required": []
        }
      },
      "args_json_schema": {},
      "return_char_limit": 50000,
      "pip_requirements": [],
      "npm_requirements": null,
      "default_requires_approval": null,
      "enable_parallel_execution": false,
      "created_by_id": "user-f57d9b1c-6c7e-411f-8501-a553817ffb23",
      "last_updated_by_id": "user-f57d9b1c-6c7e-411f-8501-a553817ffb23",
      "metadata_": {
        "tool_hash": "e1fae70b832f"
      },
      "project_id": "project-gOtlbcCC1jK8mlkoijqc"
    },
    {
      "id": "tool-3",
      "tool_type": "custom",
      "description": "Search an agent's archival (long-term) memory in Letta via HTTP API.",
      "source_type": "json",
      "name": "search_agent_archival_memory",
      "tags": [],
      "source_code": "def search_agent_archival_memory(agent_id: str, query: str, limit: int = 10) -> str:\n    \"\"\"Search an agent's archival (long-term) memory in Letta via HTTP API.\n\n    Args:\n        agent_id: The Letta agent ID whose archival memory to search.\n        query: The search query string to match against memory passages.\n        limit: Maximum number of results to return (default 10).\n\n    Returns:\n        JSON array of matching memory passages, or error JSON.\n    \"\"\"\n    import os\n    import json\n    import requests\n\n    base_url = os.environ.get(\"LETTA_BASE_URL\", \"https://api.letta.com/v1\").rstrip(\"/\")\n    api_key = os.environ.get(\"LETTA_API_KEY\", \"\")\n    try:\n        resp = requests.get(\n            f\"{base_url}/agents/{agent_id}/archival\",\n            params={\"query\": query, \"limit\": limit},\n            headers={\"Authorization\": f\"Bearer {api_key}\"},\n            timeout=30,\n        )\n        if not resp.ok:\n            return json.dumps({\"error\": f\"HTTP {resp.status_code}\"})\n        return json.dumps(resp.json())\n    except Exception as e:\n        return json.dumps({\"error\": str(e)})\n",
      "json_schema": {
        "name": "search_agent_archival_memory",
        "description": "Search an agent's archival (long-term) memory in Letta via HTTP API.",
        "parameters": {
          "type": "object",
          "properties": {
            "agent_id": {
              "type": "string",
              "description": "The Letta agent ID whose archival memory to search."
            },
            "query": {
              "type": "string",
              "description": "The search query string to match against memory passages."
            },
            "limit": {
              "type": "integer",
              "description": "Maximum number of results to return (default 10)."
            }
          },
          "required": [
            "agent_id",
            "query"
          ]
        }
      },
      "args_json_schema": {},
      "return_char_limit": 50000,
      "pip_requirements": null,
      "npm_requirements": null,
      "default_requires_approval": null,
      "enable_parallel_execution": false,
      "created_by_id": "user-f57d9b1c-6c7e-411f-8501-a553817ffb23",
      "last_updated_by_id": "user-f57d9b1c-6c7e-411f-8501-a553817ffb23",
      "metadata_": {
        "tool_hash": "df2fa0289a4e"
      },
      "project_id": "project-gOtlbcCC1jK8mlkoijqc"
    },
    {
      "id": "tool-2",
      "tool_type": "custom",
      "description": "Update a Paperclip issue status and optionally add a comment.\n\nCall this immediately when you receive an issue assignment to claim it\n(status \"in_progress\"), and again when the gremlin reports completion\n(status \"done\").\n\nStatus values: \"todo\", \"in_progress\", \"in_review\", \"done\", \"cancelled\", \"blocked\"",
      "source_type": "python",
      "name": "update_paperclip_issue",
      "tags": [],
      "source_code": "def update_paperclip_issue(\n    issue_id: str,\n    status: str = \"\",\n    assignee_agent_id: str = \"\",\n    comment: str = \"\",\n) -> str:\n    \"\"\"Update a Paperclip issue \u2014 set status, assign to a gremlin, or add a comment.\n\n    You can update status and assignee in the same call, or separately.\n    To assign a gremlin without changing status, pass only issue_id and assignee_agent_id.\n\n    Status values: \"todo\" | \"in_progress\" | \"in_review\" | \"done\" | \"cancelled\" | \"blocked\" | \"backlog\"\n\n    Args:\n        issue_id: The Paperclip issue UUID (required)\n        status: New status value (optional \u2014 omit to leave unchanged)\n        assignee_agent_id: Paperclip UUID of the gremlin to assign (optional)\n        comment: Optional comment alongside the update\n\n    Returns:\n        \"OK\" on success, \"ERROR: ...\" on failure.\n    \"\"\"\n    import os, requests\n    base_url = os.environ.get(\"PAPERCLIP_BASE_URL\", \"https://hopeful-sawfish-gently.ngrok-free.app\")\n    api_key = os.environ.get(\"PAPERCLIP_API_KEY\", \"pcp_357952ccfe77a8e42d3630f90ec4a7fb79e2f1b812a590b4\")\n    if not issue_id:\n        return \"ERROR: issue_id is required\"\n    payload = {}\n    if status:\n        payload[\"status\"] = status\n    if assignee_agent_id:\n        payload[\"assigneeAgentId\"] = assignee_agent_id\n    if comment:\n        payload[\"comment\"] = comment\n    if not payload:\n        return \"ERROR: nothing to update \u2014 provide status, assignee_agent_id, or comment\"\n    try:\n        resp = requests.patch(\n            f\"{base_url}/api/issues/{issue_id}\",\n            json=payload,\n            headers={\"Authorization\": f\"Bearer {api_key}\",\n                      \"Content-Type\": \"application/json\",\n                      \"ngrok-skip-browser-warning\": \"true\"},\n            timeout=30,\n        )\n        if resp.ok:\n            data = resp.json()\n            assignee = data.get(\"assigneeAgentId\", \"none\")\n            new_status = data.get(\"status\", \"unknown\")\n            return f\"OK \u2014 status={new_status}, assignee={assignee}\"\n        return f\"ERROR: HTTP {resp.status_code} -- {resp.text[:300]}\"\n    except Exception as e:\n        return f\"ERROR: {e}\"\n",
      "json_schema": {
        "name": "update_paperclip_issue",
        "description": "Update a Paperclip issue \u2014 set status, assign to a gremlin, or add a comment. You can update status and assignee in the same call, or separately.",
        "parameters": {
          "type": "object",
          "properties": {
            "issue_id": {
              "type": "string",
              "description": "The Paperclip issue UUID (required)"
            },
            "status": {
              "type": "string",
              "description": "New status value: todo | backlog | in_progress | in_review | done | cancelled | blocked (optional \u2014 omit to leave unchanged)"
            },
            "assignee_agent_id": {
              "type": "string",
              "description": "Paperclip UUID of the gremlin to assign (optional). Use the full UUID from the gremlin registry."
            },
            "comment": {
              "type": "string",
              "description": "Optional comment alongside the update"
            }
          },
          "required": [
            "issue_id"
          ]
        }
      },
      "args_json_schema": {},
      "return_char_limit": 50000,
      "pip_requirements": [],
      "npm_requirements": null,
      "default_requires_approval": null,
      "enable_parallel_execution": false,
