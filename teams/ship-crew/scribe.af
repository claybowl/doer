    {
      "id": "tool-5",
      "tool_type": "custom",
      "description": "Post a comment on a Paperclip issue to report task results.\n\nUse this when your task is complete to log your work and notify Alfie.\nAlfie monitors issue comments to know when to mark issues done.\n\nThe issue_id is passed to you in your task description by Alfie — look for\na line like: \"Paperclip issue_id: <uuid>\"",
      "source_type": "python",
      "name": "post_issue_comment",
      "tags": [],
      "source_code": "def post_issue_comment(issue_id: str, body: str) -> str:\n    \"\"\"Post a comment on a Paperclip issue to report task results.\n\n    Args:\n        issue_id: The Paperclip issue UUID\n        body: The comment text\n\n    Returns:\n        \"OK\" on success, \"ERROR: ...\" on failure.\n    \"\"\"\n    import os, requests\n    base_url = os.environ.get(\"PAPERCLIP_BASE_URL\", \"https://f042-2600-8804-6f09-f500-402c-8ea8-a27b-35ba.ngrok-free.app\")\n    api_key = os.environ.get(\"PAPERCLIP_API_KEY\", \"pcp_357952ccfe77a8e42d3630f90ec4a7fb79e2f1b812a590b4\")\n    if not issue_id:\n        return \"ERROR: issue_id is required\"\n    try:\n        resp = requests.post(\n            f\"{base_url}/api/issues/{issue_id}/comments\",\n            json={\"body\": body},\n            headers={\"Authorization\": f\"Bearer {api_key}\",\n                      \"Content-Type\": \"application/json\",\n                      \"ngrok-skip-browser-warning\": \"true\"},\n            timeout=30,\n        )\n        return \"OK\" if resp.ok else f\"ERROR: HTTP {resp.status_code} -- {resp.text[:300]}\"\n    except Exception as e:\n        return f\"ERROR: {e}\"",
      "json_schema": {
        "name": "post_issue_comment",
        "description": "Post a comment on a Paperclip issue to report task results.\n\nUse this when your task is complete to log your work and notify Alfie.\nAlfie monitors issue comments to know when to mark issues done.\n\nThe issue_id is passed to you in your task description by Alfie — look for\na line like: \"Paperclip issue_id: <uuid>\"",
        "parameters": {
          "type": "object",
          "properties": {
            "issue_id": {
              "type": "string",
              "description": "The Paperclip issue UUID"
            },
            "body": {
              "type": "string",
              "description": "The comment text — include result summary, what was done, any blockers"
            }
          },
          "required": [
            "issue_id",
            "body"
          ]
        }
      },
      "args_json_schema": {},
