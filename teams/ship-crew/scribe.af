    {
      "id": "tool-1",
      "tool_type": "custom",
      "description": "Read a specific Paperclip issue by its UUID.\n\nUse this to get the full details of the issue you were assigned,\nincluding description, status, and comments.",
      "source_type": "python",
      "name": "read_paperclip_issue",
      "tags": [],
      "source_code": "def read_paperclip_issue(issue_id: str) -> str:\n    \"\"\"Read a specific Paperclip issue by its UUID.\n\n    Args:\n        issue_id: The Paperclip issue UUID\n\n    Returns:\n        JSON string with issue details, or \"ERROR: ...\" on failure.\n    \"\"\"\n    import os, json, requests\n    base_url = os.environ.get(\"PAPERCLIP_BASE_URL\", \"https://f042-2600-8804-6f09-f500-402c-8ea8-a27b-35ba.ngrok-free.app\")\n    api_key = os.environ.get(\"PAPERCLIP_API_KEY\", \"pcp_357952ccfe77a8e42d3630f90ec4a7fb79e2f1b812a590b4\")\n    if not issue_id:\n        return \"ERROR: issue_id is required\"\n    try:\n        resp = requests.get(\n            f\"{base_url}/api/issues/{issue_id}\",\n            headers={\"Authorization\": f\"Bearer {api_key}\",\n                      \"ngrok-skip-browser-warning\": \"true\"},\n            timeout=30,\n        )\n        if resp.ok:\n            return json.dumps(resp.json())\n        return f\"ERROR: HTTP {resp.status_code} -- {resp.text[:300]}\"\n    except Exception as e:\n        return f\"ERROR: {e}\"",
      "json_schema": {
        "name": "read_paperclip_issue",
        "description": "Read a specific Paperclip issue by its UUID.\n\nUse this to get the full details of the issue you were assigned,\nincluding description, status, and comments.",
        "parameters": {
          "type": "object",
          "properties": {
            "issue_id": {
              "type": "string",
              "description": "The Paperclip issue UUID (from PAPERCLIP_ISSUE_ID env var\nor passed in your task description)"
            }
          },
          "required": [
            "issue_id"
          ]
        }
      },
      "args_json_schema": {},
      "return_char_limit": 50000,
      "pip_requirements": [],
      "npm_requirements": null,
      "default_requires_approval": null,
      "enable_parallel_execution": false,
