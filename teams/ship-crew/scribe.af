    {
      "id": "tool-7",
      "tool_type": "custom",
      "description": "Execute a bash command in a subprocess sandbox and return the output.\n\nUse this to run shell commands, install packages, scrape the web,\nprocess files, call CLIs, or do anything a terminal can do.",
      "source_type": "python",
      "name": "execute_bash",
      "tags": [],
      "source_code": "def execute_bash(command: str, timeout: int = 60) -> str:\n    \"\"\"Execute a bash command in a subprocess sandbox and return the output.\n\n    Use this to run shell commands, install packages, scrape the web,\n    process files, call CLIs, or do anything a terminal can do.\n\n    Args:\n        command: The bash command to execute (can be multi-line with ; or &&)\n        timeout: Max seconds to wait before killing (default 60)\n\n    Returns:\n        Combined stdout + stderr + return code as a string\n    \"\"\"\n    import subprocess\n    try:\n        result = subprocess.run(\n            command,\n            shell=True,\n            capture_output=True,\n            text=True,\n            timeout=timeout,\n        )\n        out = result.stdout.strip()\n        err = result.stderr.strip()\n        rc  = result.returncode\n        parts = []\n        if out:\n            parts.append(f\"STDOUT:\\n{out}\")\n        if err:\n            parts.append(f\"STDERR:\\n{err}\")\n        parts.append(f\"EXIT CODE: {rc}\")\n        return \"\\n\\n\".join(parts) if parts else f\"EXIT CODE: {rc} (no output)\"\n    except subprocess.TimeoutExpired:\n        return f\"ERROR: Command timed out after {timeout}s\"\n    except Exception as e:\n        return f\"ERROR: {type(e).__name__}: {e}\"\n",
      "json_schema": {
        "name": "execute_bash",
        "description": "Execute a bash command in a subprocess sandbox and return the output.\n\nUse this to run shell commands, install packages, scrape the web,\nprocess files, call CLIs, or do anything a terminal can do.",
        "parameters": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "description": "The bash command to execute (can be multi-line with ; or &&)"
            },
            "timeout": {
              "type": "integer",
              "description": "Max seconds to wait before killing (default 60)"
            }
          },
          "required": [
            "command"
          ]
        }
      },
      "args_json_schema": {},
      "return_char_limit": 50000,
      "pip_requirements": null,
      "npm_requirements": null,
      "default_requires_approval": null,
      "enable_parallel_execution": false,
      "created_by_id": "user-f57d9b1c-6c7e-411f-8501-a553817ffb23",
      "last_updated_by_id": "user-f57d9b1c-6c7e-411f-8501-a553817ffb23",
      "metadata_": {
        "tool_hash": "e6a67cc23745"
      },
      "project_id": "project-gOtlbcCC1jK8mlkoijqc"
    },
    {
      "id": "tool-2",
      "tool_type": "custom",
      "description": "Execute a task in the OpenWork environment.\n\nStarts an openwrk server, submits the task, polls for completion, and returns results.\nCleans up the server process even on failure.",
      "source_type": "python",
      "name": "execute_in_openwork",
      "tags": [],
      "source_code": "def execute_in_openwork(task_description: str, timeout_minutes: int = 45) -> str:\n    \"\"\"Execute a task in the OpenWork environment.\n\n    Starts an openwrk server, submits the task, polls for completion, and returns results.\n    Cleans up the server process even on failure.\n\n    Args:\n        task_description: Description of the task to execute\n        timeout_minutes: Maximum time to wait for completion (default 45)\n\n    Returns:\n        JSON string with task results, or \"ERROR: ...\" on failure\n    \"\"\"\n    import json\n    import os\n\n    port = os.environ.get(\"OPENWORK_PORT\", \"\")\n    if not port:\n        return \"ERROR: OPENWORK_PORT not configured\"\n\n    # Start openwrk server\n    process = None\n    try:\n        process = subprocess.Popen([\"openwrk\", \"serve\", \"--port\", port])\n        time.sleep(2)  # Wait for server to start\n\n        if process.poll() is not None:\n            return \"ERROR: Failed to start openwrk server\"\n\n        # Submit task\n        submit_resp = requests.post(\n            f\"http://localhost:{port}/tasks\",\n            json={\"description\": task_description},\n            timeout=30\n        )\n        if not submit_resp.ok:\n            return f\"ERROR: Failed to submit task: HTTP {submit_resp.status_code}\"\n\n        task_id = submit_resp.json().get(\"task_id\")\n        if not task_id:\n            return \"ERROR: No task_id in submit response\"\n\n        # Poll for completion\n        start_time = time.time()\n        poll_interval = 5\n        while time.time() - start_time < timeout_minutes * 60:\n            status_resp = requests.get(f\"http://localhost:{port}/tasks/{task_id}\", timeout=30)\n            if status_resp.ok:\n                data = status_resp.json()\n                if data.get(\"status\") == \"completed\":\n                    return json.dumps(data)\n            time.sleep(poll_interval)\n\n        return f\"ERROR: Task timed out after {timeout_minutes} minutes\"\n\n    except Exception as e:\n        return f\"ERROR: {str(e)}\"\n    finally:\n        # Cleanup\n        if process:\n            process.terminate()\n            process.wait()\n",
      "json_schema": {
        "name": "execute_in_openwork",
        "description": "Execute a task in the OpenWork environment.\n\nStarts an openwrk server, submits the task, polls for completion, and returns results.\nCleans up the server process even on failure.",
        "parameters": {
          "type": "object",
          "properties": {
            "task_description": {
              "type": "string",
              "description": "Description of the task to execute"
            },
            "timeout_minutes": {
              "type": "integer",
              "description": "Maximum time to wait for completion (default 45)"
            }
          },
          "required": [
            "task_description"
          ]
        }
      },
      "args_json_schema": {},
      "return_char_limit": 50000,
      "pip_requirements": null,
      "npm_requirements": null,
      "default_requires_approval": null,
      "enable_parallel_execution": false,
      "created_by_id": "user-f57d9b1c-6c7e-411f-8501-a553817ffb23",
      "last_updated_by_id": "user-f57d9b1c-6c7e-411f-8501-a553817ffb23",
      "metadata_": {
        "tool_hash": "947b92edc81d"
