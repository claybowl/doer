    {
      "id": "tool-6",
      "tool_type": "custom",
      "description": "Save a learning insight to the shared learnings block.\n\nRetrieves existing learnings, appends the new insight, and saves back.",
      "source_type": "python",
      "name": "save_learning",
      "tags": [],
      "source_code": "def save_learning(insight: str) -> str:\n    \"\"\"Save a learning insight to the shared learnings block.\"\"\"\n    import os\n    import requests\n    from datetime import datetime\n\n    block_id = os.environ.get(\"GREMLIN_LEARNINGS_BLOCK\") or \"block-de6339e8-aa07-4768-bb0d-6aa62e25a456\"\n    base_url = os.environ.get(\"LETTA_BASE_URL\", \"https://api.letta.com/v1\").rstrip(\"/\")\n    api_key  = os.environ.get(\"LETTA_API_KEY\") or \"sk-let-NmUwOWVjZjYtYzE5ZC00NmIwLTlmNGUtMDAzOGU1MjNiYzRhOjczYWY5MzZiLTdkODMtNGY2OS05Y2JmLTQwN2JlMGRmNzU2ZA==\"\n\n    try:\n        get_resp = requests.get(\n            f\"{base_url}/blocks/{block_id}\",\n            headers={\"Authorization\": f\"Bearer {api_key}\"},\n            timeout=30,\n        )\n        if not get_resp.ok:\n            return f\"ERROR: get block HTTP {get_resp.status_code}\"\n\n        current = get_resp.json().get(\"value\", \"\") or \"\"\n        date_str = datetime.utcnow().strftime(\"%Y-%m-%d\")\n        entry = f\"\\n- [{date_str}] {insight}\"\n        new_value = current + entry\n\n        patch_resp = requests.patch(\n            f\"{base_url}/blocks/{block_id}\",\n            json={\"value\": new_value},\n            headers={\"Authorization\": f\"Bearer {api_key}\", \"Content-Type\": \"application/json\"},\n            timeout=30,\n        )\n        if patch_resp.ok:\n            return \"OK\"\n        return f\"ERROR: patch block HTTP {patch_resp.status_code}: {patch_resp.text[:200]}\"\n    except Exception as e:\n        return f\"ERROR: {e}\"\n",
      "json_schema": {
        "name": "save_learning",
        "description": "Save a learning insight to the shared learnings block.\n\nRetrieves existing learnings, appends the new insight, and saves back.",
        "parameters": {
          "type": "object",
          "properties": {
            "insight": {
              "type": "string",
              "description": "The learning insight to save"
            }
          },
          "required": [
            "insight"
          ]
        }
      },
      "args_json_schema": {},
      "return_char_limit": 50000,
      "pip_requirements": null,
      "npm_requirements": null,
      "default_requires_approval": null,
      "enable_parallel_execution": false,
      "created_by_id": "user-f57d9b1c-6c7e-411f-8501-a553817ffb23",
      "last_updated_by_id": "user-f57d9b1c-6c7e-411f-8501-a553817ffb23",
      "metadata_": {
        "tool_hash": "46567dc4f7cb"
