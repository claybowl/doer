    {
      "id": "tool-9",
      "tool_type": "custom",
      "description": "Execute Python code in a subprocess and return the output.\n\nUse this to run data processing, calculations, file I/O, API calls,\nor any Python logic. Install packages first with execute_bash if needed.",
      "source_type": "python",
      "name": "execute_python",
      "tags": [],
      "source_code": "def execute_python(code: str, timeout: int = 60) -> str:\n    \"\"\"Execute Python code in a subprocess and return the output.\n\n    Use this to run data processing, calculations, file I/O, API calls,\n    or any Python logic. Install packages first with execute_bash if needed.\n\n    Args:\n        code: Python source code to execute\n        timeout: Max seconds to wait (default 60)\n\n    Returns:\n        stdout + stderr from the Python process\n    \"\"\"\n    import subprocess\n    import tempfile\n    import os\n\n    # Write to a temp file so multi-line code works cleanly\n    with tempfile.NamedTemporaryFile(mode=\"w\", suffix=\".py\", delete=False) as f:\n        f.write(code)\n        tmp_path = f.name\n\n    try:\n        result = subprocess.run(\n            [\"python3\", tmp_path],\n            capture_output=True,\n            text=True,\n            timeout=timeout,\n        )\n        out = result.stdout.strip()\n        err = result.stderr.strip()\n        rc  = result.returncode\n        parts = []\n        if out:\n            parts.append(f\"OUTPUT:\\n{out}\")\n        if err:\n            parts.append(f\"ERRORS:\\n{err}\")\n        parts.append(f\"EXIT CODE: {rc}\")\n        return \"\\n\\n\".join(parts)\n    except subprocess.TimeoutExpired:\n        return f\"ERROR: Python script timed out after {timeout}s\"\n    except Exception as e:\n        return f\"ERROR: {type(e).__name__}: {e}\"\n    finally:\n        try:\n            os.unlink(tmp_path)\n        except Exception:\n            pass\n",
      "json_schema": {
        "name": "execute_python",
        "description": "Execute Python code in a subprocess and return the output.\n\nUse this to run data processing, calculations, file I/O, API calls,\nor any Python logic. Install packages first with execute_bash if needed.",
        "parameters": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "description": "Python source code to execute"
            },
            "timeout": {
              "type": "integer",
              "description": "Max seconds to wait (default 60)"
            }
          },
          "required": [
            "code"
          ]
        }
      },
      "args_json_schema": {},
      "return_char_limit": 50000,
      "pip_requirements": null,
      "npm_requirements": null,
      "default_requires_approval": null,
      "enable_parallel_execution": false,
      "created_by_id": "user-f57d9b1c-6c7e-411f-8501-a553817ffb23",
      "last_updated_by_id": "user-f57d9b1c-6c7e-411f-8501-a553817ffb23",
      "metadata_": {
        "tool_hash": "efa01339c68c"
