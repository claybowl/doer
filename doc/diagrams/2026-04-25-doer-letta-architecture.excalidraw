iority order.","height":192,"link":null,"strokeColor":"#b91c1c","fillStyle":"solid","groupIds":[],"versionNonce":500213585,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":[],"x":140,"angle":0,"y":1742,"width":1120},{"isDeleted":false,"locked":false,"strokeColor":"#b91c1c","link":null,"roughness":1,"groupIds":[],"index":"bCc","backgroundColor":"#fee2e2","angle":0,"fillStyle":"solid","strokeWidth":2,"version":3,"roundness":{"type":3},"updated":1777179979925,"type":"rectangle","id":"kEXnJGRxo23KqUBU2cytQ","x":130,"seed":604534100,"boundElements":[],"y":1710,"opacity":100,"height":280,"width":1140,"frameId":null,"strokeStyle":"solid","versionNonce":1651307071},{"isDeleted":false,"locked":false,"strokeColor":"#be185d","link":null,"roughness":1,"groupIds":[],"index":"bCd","backgroundColor":"#fce7f3","angle":0,"fillStyle":"solid","strokeWidth":2,"version":3,"roundness":{"type":3},"updated":1777179979925,"type":"rectangle","id":"dondog-protocols","x":130,"seed":1493198915,"boundElements":[],"y":2000,"opacity":100,"height":100,"width":1140,"frameId":null,"strokeStyle":"solid","versionNonce":2093061425},{"seed":667539556,"strokeStyle":"solid","id":"dondog-protocols-title","strokeWidth":2,"roughness":1,"isDeleted":false,"fontSize":14,"opacity":100,"verticalAlign":"top","updated":1777179979925,"locked":false,"text":"⚙  OPERATIONAL PROTOCOLS  (refers to paperclip_work_instructions block)","version":3,"autoResize":true,"type":"text","backgroundColor":"transparent","roundness":null,"index":"bCe","containerId":null,"baseline":12,"customData":null,"originalText":"⚙  OPERATIONAL PROTOCOLS  (refers to paperclip_work_instructions block)","height":27,"link":null,"strokeColor":"#be185d","fillStyle":"solid","groupIds":[],"versionNonce":1504858719,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":[],"x":140,"angle":0,"y":2010,"width":1120},{"seed":143309008,"strokeStyle":"solid","id":"dondog-protocols-hint","strokeWidth":2