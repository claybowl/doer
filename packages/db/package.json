{
  "name": "@doerai/db",
  "version": "0.3.1",
  "license": "MIT",
  "homepage": "https://github.com/doerai/doer",
  "bugs": {
    "url": "https://github.com/doerai/doer/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/doerai/doer",
    "directory": "packages/db"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && rm -rf dist/migrations && cp -r src/migrations dist/migrations",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "generate": "tsc -p tsconfig.json && drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "set-opencode-model": "tsx src/set-opencode-model.ts"
  },
  "dependencies": {
    "@doerai/shared": "workspace:*",
    "drizzle-orm": "^0.38.4",
    "embedded-postgres": "^18.1.0-beta.16",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "drizzle-kit": "^0.31.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "access": "public",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}