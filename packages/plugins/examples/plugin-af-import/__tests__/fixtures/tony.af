    {
      "id": "tool-0",
      "tool_type": "custom",
      "description": "Read the text content of a Notion page by its ID.",
      "source_type": "json",
      "name": "read_notion_page",
      "tags": [],
      "source_code": "def read_notion_page(page_id: str) -> str:\n    \"\"\"Read the text content of a Notion page by its ID.\n\n    Args:\n        page_id: The Notion page UUID to read (with or without dashes).\n\n    Returns:\n        Extracted text content of the page, or 'ERROR: ...' on failure.\n    \"\"\"\n    import os\n    import requests\n\n    api_key = os.environ.get(\"NOTION_API_KEY\", \"\")\n    if not api_key:\n        return \"ERROR: NOTION_API_KEY not configured\"\n    try:\n        resp = requests.get(\n            f\"https://api.notion.com/v1/blocks/{page_id}/children\",\n            headers={\n                \"Authorization\": f\"Bearer {api_key}\",\n                \"Notion-Version\": \"2022-06-28\",\n            },\n            timeout=30,\n        )\n        if not resp.ok:\n            return f\"ERROR: HTTP {resp.status_code} — {resp.text[:200]}\"\n        blocks = resp.json().get(\"results\", [])\n        lines = []\n        for block in blocks:\n            btype = block.get(\"type\", \"\")\n            block_data = block.get(btype, {})\n            rich_text = block_data.get(\"rich_text\", [])\n            text = \"\".join(rt.get(\"plain_text\", \"\") for rt in rich_text)\n            if text.strip():\n                if btype.startswith(\"heading\"):\n                    lines.append(f\"\\n## {text}\")\n                else:\n                    lines.append(text)\n        return \"\\n\".join(lines) if lines else \"(empty page)\"\n    except Exception as e:\n        return f\"ERROR: {e}\"\n",
      "json_schema": {
        "name": "read_notion_page",
        "description": "Read the text content of a Notion page by its ID.",
        "parameters": {
          "type": "object",
          "properties": {
            "page_id": {
              "type": "string",
              "description": "The Notion page UUID to read (with or without dashes)."
            }
          },
          "required": [
            "page_id"
          ]
        }
      },
      "args_json_schema": {},
      "return_char_limit": 50000,
      "pip_requirements": null,
      "npm_requirements": null,
      "default_requires_approval": null,
      "enable_parallel_execution": false,
      "created_by_id": "user-f57d9b1c-6c7e-411f-8501-a553817ffb23",
      "last_updated_by_id": "user-f57d9b1c-6c7e-411f-8501-a553817ffb23",
      "metadata_": {
        "tool_hash": "d7b39a866e90"
