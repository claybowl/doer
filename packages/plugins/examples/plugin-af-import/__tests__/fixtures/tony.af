    {
      "id": "tool-13",
      "tool_type": "custom",
      "description": "Get the current time in the specified timezone.",
      "source_type": "json",
      "name": "get_time",
      "tags": [],
      "source_code": "def get_time(timezone_name: str = \"America/Chicago\") -> str:\n    \"\"\"Get the current time in the specified timezone.\n\n    Args:\n        timezone_name: IANA timezone name (e.g. 'America/Chicago', 'UTC', 'US/Pacific').\n\n    Returns:\n        Formatted time string like '2026-03-17 18:30:00 CDT (Monday)'.\n    \"\"\"\n    try:\n        from datetime import datetime\n        import importlib\n        zoneinfo = importlib.import_module(\"zoneinfo\")\n        ZoneInfo = zoneinfo.ZoneInfo\n        tz = ZoneInfo(timezone_name)\n        now = datetime.now(tz)\n        return now.strftime(\"%Y-%m-%d %H:%M:%S %Z (%A)\")\n    except Exception:\n        try:\n            from datetime import datetime, timezone\n            now = datetime.now(timezone.utc)\n            return now.strftime(f\"%Y-%m-%d %H:%M:%S UTC (fallback — {timezone_name} unavailable)\")\n        except Exception as e:\n            return f\"ERROR: {e}\"\n",
      "json_schema": {
        "name": "get_time",
        "description": "Get the current time in the specified timezone.",
        "parameters": {
          "type": "object",
          "properties": {
            "timezone_name": {
              "type": "string",
              "description": "IANA timezone name (e.g. 'America/Chicago', 'UTC', 'US/Pacific')."
            }
          },
          "required": []
        }
      },
      "args_json_schema": {},
      "return_char_limit": 50000,
      "pip_requirements": null,
      "npm_requirements": null,
      "default_requires_approval": null,
      "enable_parallel_execution": false,
      "created_by_id": "user-f57d9b1c-6c7e-411f-8501-a553817ffb23",
      "last_updated_by_id": "user-f57d9b1c-6c7e-411f-8501-a553817ffb23",
