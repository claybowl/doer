    {
      "id": "tool-12",
      "tool_type": "custom",
      "description": "Create a new issue in Paperclip and optionally assign it to an agent.\n\nWhen assigned, Paperclip automatically wakes the assignee agent.\nUse this to stock the kitchen queue with work for Alfie and the gremlins.\n\nPriority values: \"critical\", \"high\", \"medium\", \"low\"\nStatus defaults to \"todo\" so Alfie sees it immediately.",
      "source_type": "python",
      "name": "create_paperclip_issue",
      "tags": [],
      "source_code": "def create_paperclip_issue(\n    title: str,\n    description: str,\n    assignee_agent_id: str = \"\",\n    priority: str = \"medium\",\n    project_id: str = \"\",\n) -> str:\n    \"\"\"Create a new issue in Paperclip and optionally assign it to an agent.\n\n    Priority values: \"critical\" | \"high\" | \"medium\" | \"low\"\n\n    Args:\n        title: Clear, actionable issue title\n        description: Full context — what, why, constraints, success criteria\n        assignee_agent_id: Paperclip agent UUID of the assignee (optional)\n        priority: Issue priority\n        project_id: Paperclip project UUID (optional — leave blank for unassigned)\n\n    Returns:\n        New issue identifier on success, or \"ERROR: ...\" on failure.\n    \"\"\"\n    import os, requests\n    base_url = os.environ.get(\"PAPERCLIP_BASE_URL\", \"https://hopeful-sawfish-gently.ngrok-free.app\")\n    api_key = os.environ.get(\"PAPERCLIP_API_KEY\", \"pcp_357952ccfe77a8e42d3630f90ec4a7fb79e2f1b812a590b4\")\n    company_id = os.environ.get(\"PAPERCLIP_COMPANY_ID\", \"27b25893-0ff4-4d81-b45b-9631e04b769a\")\n    payload = {\n        \"title\": title,\n        \"description\": description,\n        \"status\": \"todo\",\n        \"priority\": priority,\n    }\n    if assignee_agent_id:\n        payload[\"assigneeAgentId\"] = assignee_agent_id\n    if project_id:\n        payload[\"projectId\"] = project_id\n    try:\n        resp = requests.post(\n            f\"{base_url}/api/companies/{company_id}/issues\",\n            json=payload,\n            headers={\"Authorization\": f\"Bearer {api_key}\",\n                      \"Content-Type\": \"application/json\",\n                      \"ngrok-skip-browser-warning\": \"true\"},\n            timeout=30,\n        )\n        if resp.ok:\n            data = resp.json()\n            return data.get(\"identifier\", data.get(\"id\", \"OK\"))\n        return f\"ERROR: HTTP {resp.status_code} -- {resp.text[:300]}\"\n    except Exception as e:\n        return f\"ERROR: {e}\"\n",
      "json_schema": {
        "name": "create_paperclip_issue",
        "description": "Create a new issue in Paperclip and optionally assign it to an agent.\n\nWhen assigned, Paperclip automatically wakes the assignee agent.\nUse this to stock the kitchen queue with work for Alfie and the gremlins.\n\nPriority values: \"critical\", \"high\", \"medium\", \"low\"\nStatus defaults to \"todo\" so Alfie sees it immediately.",
        "parameters": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "description": "Clear, actionable issue title (one sentence)"
            },
            "description": {
              "type": "string",
              "description": "Full context — what needs doing, why, constraints, success criteria"
            },
            "assignee_agent_id": {
              "type": "string",
              "description": "Letta agent ID of the agent to assign (leave blank for unassigned)"
            },
            "priority": {
              "type": "string",
              "description": "\"critical\" | \"high\" | \"medium\" | \"low\""
            },
            "project_id": {
              "type": "string",
              "description": "Paperclip project UUID (defaults to PAPERCLIP_KITCHEN_PROJECT_ID env var)"
            }
          },
          "required": [
            "title",
            "description"
          ]
        }
      },
      "args_json_schema": {},
